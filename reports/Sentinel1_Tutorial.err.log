# Open measurement GeoTIFFs (common in Level-1 GRD products)
import rioxarray as rxr
import numpy as np
import matplotlib.pyplot as plt

# Replace with path to actual measurement GeoTIFF inside the SAFE structure.
# Example typical path: example.SAFE/measurement/s1a-iw-grd-vv-...tiff
tiff_path = "example.SAFE/measurement/some_measurement.tiff"

try:
    da = rxr.open_rasterio(tiff_path)  # returns DataArray with (band, y, x)
    print(da)
    # Many GRD GeoTIFFs have a single band per polarisation, or multi-band stacks.
    # Select the first band as an example:
    img = da[0].astype(float)
    # Convert to dB (if the values are power or intensity):
    img_db = 10 * np.log10(np.where(img>0, img, np.nan))
    plt.figure(figsize=(8,6))
    img_db.plot.imshow(vmin=-30, vmax=5)
    plt.title("Example channel (dB) — replace with your VV/VH band")
    plt.xlabel("x")
    plt.ylabel("y")
    plt.show()
except Exception as e:
    print("Failed to open TIFF — replace tiff_path with your file. Error:", e)

